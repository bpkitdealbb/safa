{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".*", "**/.*", "node_modules/**", "tests/**", "firestore.rules", "*.md", "*.js.map"],
    "rewrites": [{ "source": "/", "destination": "/index-cloud.html" }],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index-cloud.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
