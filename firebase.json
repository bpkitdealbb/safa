{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tests/**", "legacy/**", "firestore.rules", "*.md"],
    "rewrites": [
      { "source": "/catalog", "destination": "/catalog.html" },
      { "source": "/catalog/**", "destination": "/catalog.html" },
      { "source": "/", "destination": "/index-cloud.html" },
      { "source": "/*", "destination": "/catalog.html" },
      { "source": "/*/", "destination": "/catalog.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index-cloud.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/catalog.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
